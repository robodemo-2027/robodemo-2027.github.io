      "name": "Folding",
      "tasks": [
        "FoldBox",
        "FoldTowel"
      ],
      "rule": "Fold-prefixed tasks."
    },
    {
      "id": "G3",
      "name": "Opening",
      "tasks": [
        "LiftLidFromSkillet",
        "OpenBox",
        "OpenLiquidCap"
      ],
      "rule": "Open-prefixed tasks and lifting a lid."
    },
    {
      "id": "G4",
      "name": "Food-tool handling",
      "tasks": [
        "CutFruit",
        "GrindFood",
        "StirSpoon",
        "TransFood"
      ],
      "rule": "Cutting, grinding, stirring and spoon-mediated food transfer; pressing and pouring are separate action families."
    },
    {
      "id": "G5",
      "name": "Picking & sorting",
      "tasks": [
        "PickAppleBananaToBaskets",
        "PickAppleBasket",
        "PickFood",
        "PickFruitsToPlate",
        "PickPillToRegions",
        "PickRemoteControl",
        "PickTennisBallGolfBall",
        "PickWash"
      ],
      "rule": "Pick-prefixed tasks except the explicit scale-directed task. PickWash is bottle picking, not washing."
    },
    {
      "id": "G6",
      "name": "Placement & storage",
      "tasks": [
        "KnifeBowlFork",
        "PlaceBookBookcase",
        "PlaceBrushRest",
        "PlaceBurgerTray",
        "PlaceChipsRack",
        "PlaceClothBasket",
        "PlaceCommodityRack",
        "PlaceCupPlate",
        "PlaceFileFolder",
        "PlaceFruitBox",
        "PlaceMagazineFolder",
        "PlaceMugRack",
        "PlacePillBox",
        "PlacePlateRack",
        "PlaceScrewdriver",
        "PlaceShoeBox",
        "PutBox"
      ],
      "rule": "Place-prefixed tasks except the explicit scale-directed task, plus PutBox and arranging cutlery (KnifeBowlFork). Surfaces, racks, folders and containers are retained in this broad placement family."
    },
    {
      "id": "G7",
      "name": "Pouring",
      "tasks": [
        "PourCup",
        "PourKetchupFries",
        "PourKettle",
        "PourLiquidCup",
        "PourLiquidFilter",
        "PourLiquidMug"
      ],
      "rule": "Pour-prefixed tasks."
    },
    {
      "id": "G8",
      "name": "Pressing",
      "tasks": [
        "PressJuicer",
        "PressStapler"
      ],
      "rule": "Press-prefixed tasks."
    },
    {
      "id": "G9",
      "name": "Measuring & scanning",
      "tasks": [
        "PickAppleToScale",
        "PlaceFoodScale",
        "PutCubeOnScale",
        "ScanMilkBox",
        "ScanPillBottle"
      ],
      "rule": "Tasks explicitly directed to a scale or scanner. This device-interaction family combines weighing and scanning and does not imply each device subtype is won."
    }
